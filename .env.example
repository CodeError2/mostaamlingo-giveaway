# انسخ هذا الملف باسم .env واملأ المفاتيح
PORT=3000

# يوتيوب: Google Cloud Console -> YouTube Data API v3 -> API key (مجاني)
YOUTUBE_API_KEY=

# فيسبوك: Page Access Token لصفحتك (صلاحية pages_read_engagement / pages_read_user_content)
FACEBOOK_ACCESS_TOKEN=
# اختياري: رقم صفحتك، للمنشورات العادية (posts/pfbid...)
FACEBOOK_PAGE_ID=

# تيك توك: لا يحتاج مفتاح


# فيسبوك (الأسهل): توكن من https://console.apify.com/settings/integrations (تسجيل بحساب جوجل)
APIFY_TOKEN=
